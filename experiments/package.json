{
  "name": "@qr-bc/experiments",
  "version": "0.0.0-dev",
  "private": true,
  "description": "Reviewer-runnable scripts that regenerate paper Tables 3 + 4 and exercise SR1–SR4",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint . --ext .ts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "exp:perf-registration": "tsx perf-registration/run.ts",
    "exp:perf-verification": "tsx perf-verification/run-all.ts",
    "exp:cost-analysis": "tsx cost-analysis/run.ts",
    "exp:adversarial": "tsx adversarial/run-all.ts",
    "exp:all": "tsx all/run-all.ts",
    "exp:seed:pairs": "tsx seed/seed-pairs.ts",
    "exp:seed:redeem": "tsx seed/seed-redeem.ts"
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0",
    "@qr-bc/shared": "workspace:*",
    "chartjs-node-canvas": "^5.0.0",
    "csv-stringify": "^6.5.2",
    "dotenv": "^17.4.2",
    "ethers": "^6.13.4"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
