# Network — `hardhat` (local, deterministic) or `amoy` (Polygon testnet).
NETWORK=hardhat

# Hub base URL for verification experiments. Required for perf-verification.
HUB_BASE_URL=http://localhost:3000/api/v1

# Hardhat-only: defaults to http://127.0.0.1:8545 if unset.
HARDHAT_RPC_URL=http://127.0.0.1:8545

# Amoy-only: required when NETWORK=amoy.
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
AMOY_PRIVATE_KEY=0xPRODUCER_PRIVATE_KEY_HERE
PRODUCT_REGISTRY_ADDRESS=0x...

# Polygon gas-price + USD-rate sources used by cost-analysis (overridable
# so reviewers can pin a snapshot timestamp). Defaults are the values
# the paper used.
GAS_PRICE_GWEI=30
MATIC_USD=0.55
GAS_PRICE_TIMESTAMP=2026-04-01T00:00:00Z

# Hub-paid producer for perf-registration on Amoy (must be funded).
PRODUCER_EMAIL=experiments@example.test
PRODUCER_PASSWORD=experiments-password-AAAAAAAAAA
