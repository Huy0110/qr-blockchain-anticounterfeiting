# Root-level environment defaults consumed by docker-compose.yml.
#
# `cp .env.example .env` and fill the secrets below before running
# `make demo` or any non-ephemeral profile. Compose's defaults are
# placeholder strings only.
#
# Generate cryptographic secrets with:
#   openssl rand -base64 32        # JWT_SECRET, REFRESH_SECRET, DAILY_SALT_SECRET
#   openssl rand -base64 32        # WALLET_ENCRYPTION_KEK (must decode to 32 raw bytes)
#   openssl rand -base64 32        # NEXTAUTH_SECRET

# --- Hub auth + crypto ---
JWT_SECRET=
REFRESH_SECRET=
WALLET_ENCRYPTION_KEK=
DAILY_SALT_SECRET=

# --- Management portal (NextAuth) ---
NEXTAUTH_SECRET=

# --- Network selection (default profile uses hardhat; testnet|prod
#     override via the corresponding compose -f flag) ---
NETWORK=hardhat
RPC_URL=http://hardhat:8545
IPFS_PROVIDER=local

# --- Required for `--profile testnet` ---
# AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# CONTRACT_ADDRESS=0x...
# SYSTEM_WALLET_PRIVATE_KEY=0x...

# --- Required for `--profile prod` (mainnet, externalised storage) ---
# MONGO_URI=mongodb+srv://...@...
# RPC_URL=https://polygon-rpc.com
# CONTRACT_ADDRESS=0x...
# SYSTEM_WALLET_PRIVATE_KEY=0x...
# PINATA_JWT=eyJ...

# --- Optional UI customisation ---
# NEXT_PUBLIC_BLOCKCHAIN_EXPLORER=https://amoy.polygonscan.com
