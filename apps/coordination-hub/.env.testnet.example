# ============================================================================
# .env.testnet.example — Polygon Amoy operator template
# ============================================================================
# This template is for running the hub against the Amoy testnet — the
# default reproducibility path for paper reviewers per
# docs/REPRODUCIBILITY.md. All values are safe to keep on a single
# developer machine; the Amoy wallet only holds free faucet MATIC.
# ============================================================================

# --- App ------------------------------------------------------------------
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
EXPOSE_SWAGGER=true
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# --- Auth -----------------------------------------------------------------
# Generate 32-char secrets even for testnet so a reviewer's local
# session can't be forged:
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=24h
REFRESH_SECRET=
REFRESH_EXPIRES_IN=30d

# --- Wallet encryption ----------------------------------------------------
# 32 raw bytes base64-encoded:
#   openssl rand -base64 32
WALLET_ENCRYPTION_KEK=

# --- Database -------------------------------------------------------------
# Local mongo via docker-compose, or a free Atlas cluster.
MONGO_URI=mongodb://mongo:27017/qr_bc

# --- Blockchain (Polygon Amoy testnet) ------------------------------------
NETWORK=amoy
RPC_URL=https://rpc-amoy.polygon.technology
# Set after `forge script Deploy.s.sol --rpc-url $RPC_URL --broadcast`.
# The script writes contracts/out/address.amoy.json; copy the value here.
CONTRACT_ADDRESS=
# Amoy-only wallet. Fund via the official faucet:
#   https://faucet.polygon.technology/  (select "Polygon Amoy")
# DO NOT reuse this key on mainnet — even after the faucet runs dry,
# anyone who pulls this repo can replay testnet txs from your address.
SYSTEM_WALLET_PRIVATE_KEY=
TX_CONFIRMATIONS=2
TX_TIMEOUT_SECONDS=90

# --- IPFS -----------------------------------------------------------------
# Default to local Kubo (docker-compose's `ipfs` service) for the
# reviewer-runnable path; switch to Pinata sandbox if you want pins to
# persist beyond the docker volume.
IPFS_PROVIDER=local
IPFS_API_URL=http://ipfs:5001
IPFS_GATEWAY_URL=http://ipfs:8080
# Optional Pinata sandbox JWT (free tier) — gives the dApp pin a
# public gateway URL without an Amoy node. Distinct from the
# PINATA_JWT in .env.production.example.
PINATA_JWT=

# --- Rate limit / observability ------------------------------------------
RATE_LIMIT_LOGIN_PER_15M=5
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_SCAN_PRIVATE_PER_MIN=60
RATE_LIMIT_AUTH_GENERIC_PER_MIN=600

# --- Misc -----------------------------------------------------------------
DAILY_SALT_ROTATE_HOUR_UTC=0
DAILY_SALT_SECRET=
LOG_PUBLIC_SCANS=true
