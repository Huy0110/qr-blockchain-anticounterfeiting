# ============================================================================
# .env.production.example — Polygon mainnet operator template
# ============================================================================
# DO NOT commit a real .env.production. Real values come from your secrets
# vault (AWS Secrets Manager, GCP Secret Manager, HashiCorp Vault, etc.).
# This file documents which variables the hub expects in production.
#
# See docs/MAINNET_DEPLOY.md for the full pre-deploy checklist + KMS
# migration path. v1.0.0 of this artifact has NOT been deployed to
# Polygon mainnet by the authors; this template exists so a future
# operator can follow the documented procedure.
# ============================================================================

# --- App ------------------------------------------------------------------
NODE_ENV=production
PORT=3000
LOG_LEVEL=warn
# Disable Swagger in production — it leaks endpoint metadata to anonymous
# scrapers and increases the attack surface. Re-enable temporarily on a
# private internal route if you need it for debugging.
EXPOSE_SWAGGER=false
# Production CORS: only your own portals. Wildcards are unsafe here.
CORS_ORIGINS=https://producer.example.com,https://verify.example.com

# --- Auth -----------------------------------------------------------------
# Generate ≥ 32-char random secrets per environment. Rotate every 90 days.
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=24h
REFRESH_SECRET=
REFRESH_EXPIRES_IN=30d

# --- Wallet encryption ----------------------------------------------------
# 32 raw bytes, base64-encoded. Held in the secrets vault — NEVER in the
# repo, NEVER in CI logs. Rotation requires re-wrapping every producer
# wallet (rotation procedure is post-v1).
WALLET_ENCRYPTION_KEK=

# --- Database -------------------------------------------------------------
# MongoDB Atlas (or self-hosted replica set with TLS). DO NOT point this
# at a single-instance Mongo; the audit log relies on majority-read
# concern.
MONGO_URI=mongodb+srv://qr-bc-prod-user@your-cluster.mongodb.net/qr_bc?retryWrites=true&w=majority

# --- Blockchain (Polygon mainnet) -----------------------------------------
NETWORK=mainnet
# Use a paid RPC provider with SLA (Alchemy, Infura, dRPC, QuickNode).
# Public rpc.polygon.com is rate-limited and not suitable for production.
RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your-alchemy-key
# Deployed via contracts/script/Deploy.s.sol; address committed to
# contracts/deployments/mainnet.json after a successful deploy.
CONTRACT_ADDRESS=
# ⚠️  KMS migration (mandatory for mainnet) ⚠️
# v1's hub still reads SYSTEM_WALLET_PRIVATE_KEY as a raw hex string.
# That is acceptable on Amoy (free faucet MATIC) but UNSAFE on mainnet.
# Before going live with real producer redemptions:
#   1. Provision a KMS key (AWS KMS / GCP Cloud KMS / Vault transit).
#   2. Top up the KMS-controlled address with ≥ 5 MATIC.
#   3. Swap the hub's blockchain.module.ts signer to the KMS adapter
#      (ethers-aws-kms-signer or equivalent). Path: see
#      docs/MAINNET_DEPLOY.md §"KMS migration notes".
#   4. Set SYSTEM_WALLET_KMS_KEY_ID and leave SYSTEM_WALLET_PRIVATE_KEY
#      empty.
# Until the KMS swap lands, this var being set in production is a
# bug — the deployment is one credential leak away from a drained wallet.
SYSTEM_WALLET_PRIVATE_KEY=
SYSTEM_WALLET_KMS_KEY_ID=
# Polygon mainnet finality is ~30 s. Use 3 confirmations for the
# audit-log timestamp to settle under network reorgs.
TX_CONFIRMATIONS=3
TX_TIMEOUT_SECONDS=120

# --- IPFS (Pinata production tier) ----------------------------------------
IPFS_PROVIDER=pinata
PINATA_JWT=
# Production gateway domain (DNSLink → CID). Custom domain optional;
# fall back to gateway.pinata.cloud while you're setting it up.
IPFS_GATEWAY_URL=https://gateway.pinata.cloud
# Pinata API URL — same endpoint regardless of plan tier. Pro tier just
# raises the pin-size limit + lifts the rate cap.
IPFS_API_URL=https://api.pinata.cloud

# --- Rate limit / observability ------------------------------------------
# Tighter limits than dev. If you see legitimate users tripping these,
# tune up rather than disabling.
RATE_LIMIT_LOGIN_PER_15M=10
RATE_LIMIT_REGISTER_PER_HOUR=20
RATE_LIMIT_SCAN_PRIVATE_PER_MIN=120
RATE_LIMIT_AUTH_GENERIC_PER_MIN=600

# --- Misc -----------------------------------------------------------------
DAILY_SALT_ROTATE_HOUR_UTC=0
DAILY_SALT_SECRET=
# Public-scan logging stays on so the verification analytics page has
# data. The verificationLogs collection hashes IPs with the daily salt;
# no PII at rest.
LOG_PUBLIC_SCANS=true
