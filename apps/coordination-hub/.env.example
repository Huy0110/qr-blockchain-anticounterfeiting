# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
EXPOSE_SWAGGER=true
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=24h
REFRESH_SECRET=
REFRESH_EXPIRES_IN=30d

# Wallet encryption
WALLET_ENCRYPTION_KEK=

# Database
MONGO_URI=mongodb://mongo:27017/qr_bc

# Blockchain
NETWORK=hardhat
RPC_URL=http://hardhat:8545
CONTRACT_ADDRESS=
SYSTEM_WALLET_PRIVATE_KEY=
TX_CONFIRMATIONS=1
TX_TIMEOUT_SECONDS=60

# IPFS
IPFS_PROVIDER=local
IPFS_API_URL=http://ipfs:5001
IPFS_GATEWAY_URL=http://ipfs:8080
PINATA_JWT=

# Rate limit / observability
RATE_LIMIT_LOGIN_PER_15M=5
RATE_LIMIT_REGISTER_PER_HOUR=3
RATE_LIMIT_SCAN_PRIVATE_PER_MIN=60
RATE_LIMIT_AUTH_GENERIC_PER_MIN=600

# Misc
DAILY_SALT_ROTATE_HOUR_UTC=0
# 32 random bytes base64-encoded; combined with date+rotate-hour into the
# per-day IP salt used by verificationLogs.ipHash. Set in production.
DAILY_SALT_SECRET=
LOG_PUBLIC_SCANS=true
